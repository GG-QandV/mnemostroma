[Unit]
Description=Serveo SSH Tunnel for Mnemostroma MCP SSE
After=mnemostroma-sse.service
Wants=mnemostroma-sse.service

[Service]
ExecStart=/usr/bin/ssh \
    -o ServerAliveInterval=60 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=no \
    -R mnemostroma:80:localhost:8765 \
    serveo.net
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
